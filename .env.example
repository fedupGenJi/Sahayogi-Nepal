# Copy to .env (never commit). Use a SEPARATE Supabase project for demo.
# Used by scripts/*.mjs and by your local shell. Run scripts with:  node --env-file=.env scripts/seed_users.mjs
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-me
# SERVER ONLY: scripts + Edge Functions. Never put in Flutter or admin web.
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_DB_PASSWORD=replace-me
# Map provider key (restrict by app signature / bundle ID if Google)
MAPS_API_KEY=
# Server-only key used by the Supabase assist-form Edge Function.
OPENAI_API_KEY=
FORM_ASSISTANT_MODEL=gpt-4o-mini

# --- Demo seeding (scripts/seed_users.mjs) ---
# Leave empty to auto-generate a random strong password (printed once).
# Must be >= 10 chars with upper, lower, digit and symbol (matches the Auth password policy).
DEMO_PASSWORD=
# Required to run the seed against a non-local project (safety guard)
ALLOW_DEMO_SEED=
when true 
ADMIN_EMAIL=adminGmail
ADMIN_NAME=adminName
ADMIN_PASSWORD=adminpass

# --- Resend SMTP for Supabase Auth emails (read by [auth.email.smtp] in config.toml) ---
RESEND_API_KEY=
MAIL_FROM_ADDRESS=
# --- Hosted project seeding (scripts/seed_demo.mjs, scripts/reset_demo_remote.mjs) ---
# Set these IN .env (works the same on Windows, macOS, Linux) - no inline VAR=value needed.
# Point SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY at the DEMO project, set ALLOW_DEMO_SEED=yes and DEMO_PASSWORD.
# reset_demo_remote.mjs also needs CONFIRM_PROJECT_REF=<the xxxx in https://xxxx.supabase.co>
CONFIRM_PROJECT_REF=
